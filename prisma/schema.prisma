// ==========================================
// COMPLETE CMS DATABASE SCHEMA WITH POST CATEGORIES
// Georgian Government Business Support Site
// Multilingual (Dynamic Languages) + User-Friendly CMS
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// LANGUAGES
// ==========================================

enum TextDirection {
  ltr
  rtl
}

enum PostType {
  news
  success
  course
}

model Language {
  id           Int           @id @default(autoincrement())
  code         String        @unique @db.VarChar(8)
  name         String        @db.VarChar(100)
  englishName  String?       @map("english_name") @db.VarChar(100)
  georgianName String?       @map("georgian_name") @db.VarChar(100)
  flagEmoji    String?       @map("flag_emoji") @db.VarChar(10)
  direction    TextDirection @default(ltr)
  isActive     Boolean       @default(true) @map("is_active")
  isDefault    Boolean       @default(false) @map("is_default")
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relations - All complete ✅
  pageTranslations           PageTranslation[]
  pageSlugAliases            PageSlugAlias[]
  pageVersions               PageVersion[]
  postVersions               PostVersion[]
  postTranslations           PostTranslation[]
  postSlugAliases            PostSlugAlias[]
  pageTemplates              PageTemplateTranslation[]
  menuItemTranslation        MenuItemTranslation[]
  postCategoryTranslations   PostCategoryTranslation[] // ← NEW
  settingLocalizedContent    SettingLocalizedContent[]
  cannedResponseTranslations CannedResponseTranslation[]

  @@index([code])
  @@index([isActive])
  @@index([isDefault])
  @@map("languages")
}

// ==========================================
// ADMIN & AUTHENTICATION
// ==========================================

model User {
  id            Int       @id @default(autoincrement())
  firstName     String    @map("first_name") @db.VarChar(255)
  lastName      String    @map("last_name") @db.VarChar(255)
  displayName   String    @map("display_name") @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  password      String    @db.VarChar(255)
  avatarMediaId Int?      @map("avatar_media_id")
  isActive      Boolean   @default(true) @map("is_active")
  lastLogin     DateTime? @map("last_login") @db.Timestamp(0)
  lastSeen      DateTime? @map("last_seen") @db.Timestamp(0)
  refreshToken  String?   @map("refresh_token") @db.Text
  deletedAt     DateTime? @map("deleted_at") @db.Timestamp(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // Password reset — SHA-256 hash of a random opaque token, not the raw
  // token itself (see docs/reset-password/backend-design.md). Cleared on
  // use or expiry check, so a stale hash alone doesn't grant access.
  passwordResetTokenHash String?   @map("password_reset_token_hash") @db.VarChar(64)
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at") @db.Timestamp(0)

  roles                  UserRole[]
  userPermissions        UserPermission[]
  auditLogs              AuditLog[]             @relation("AuditLogActor")
  createdPages           Page[]                 @relation("PageCreatedBy")
  updatedPages           Page[]                 @relation("PageUpdatedBy")
  posts                  Post[]                 @relation("PostAuthor")
  // mediaUploads     Media[]            @relation("MediaUploadedBy")
  createdTemplates       PageTemplate[]         @relation("TemplateCreatedBy")
  updatedTemplates       PageTemplate[]         @relation("TemplateUpdatedBy")
  triggeredNotifications Notification[]         @relation("NotificationActor")
  notificationState      UserNotificationState?
  avatarMedia            Media?                 @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  chatSessions           ChatSession[]          @relation("ChatOperator")
  chatSessionsAsKnown    ChatSession[]          @relation("ChatKnownUser")
  chatSessionsClosed     ChatSession[]          @relation("ChatClosedBy")
  chatMessages           ChatMessage[]          @relation("ChatMessageAuthor")
  dmThreadsAsP1          OperatorThread[]       @relation("DmParticipant1")
  dmThreadsAsP2          OperatorThread[]       @relation("DmParticipant2")
  dmMessages             OperatorMessage[]      @relation("DmAuthor")
  cannedResponses        CannedResponse[]       @relation("CannedResponseAuthor")

  @@index([email])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  users       UserRole[]
  permissions RolePermission[]
  manages     RoleManagement[] @relation("RoleManagementManager")
  managedBy   RoleManagement[] @relation("RoleManagementManaged")

  @@index([slug])
  @@map("roles")
}

// Data-driven "who can CRUD whose accounts" policy — e.g. (chat-supervisor
// -> operator). One generic ManagedUsersController resolves scope from this
// table instead of a bespoke controller per manager/subordinate role pair.
model RoleManagement {
  id              Int    @id @default(autoincrement())
  managerRoleSlug String @map("manager_role_slug") @db.VarChar(255)
  managedRoleSlug String @map("managed_role_slug") @db.VarChar(255)

  managerRole Role @relation("RoleManagementManager", fields: [managerRoleSlug], references: [slug], onDelete: Cascade)
  managedRole Role @relation("RoleManagementManaged", fields: [managedRoleSlug], references: [slug], onDelete: Cascade)

  @@unique([managerRoleSlug, managedRoleSlug])
  @@map("role_management")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id    Int    @id @default(autoincrement())
  key   String @unique @db.VarChar(100)
  label String @db.VarChar(255)
  group String @default("general") @db.VarChar(50)

  roles           RolePermission[]
  userPermissions UserPermission[]

  @@index([group])
  @@map("permissions")
}

model UserPermission {
  userId       Int     @map("user_id")
  permissionId Int     @map("permission_id")
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@map("user_permissions")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  action     String   @db.VarChar(100)
  targetType String   @db.VarChar(50)
  targetId   Int?     @map("target_id")
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==========================================
// PAGE TEMPLATES
// ==========================================

model PageTemplate {
  id          Int       @id @default(autoincrement())
  slug        String    @unique @db.VarChar(100)
  postType    PostType? @map("post_type")
  createdById Int?      @map("created_by_id")
  updatedById Int?      @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy    User?                     @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                     @relation("TemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  translations PageTemplateTranslation[]
  pages        Page[]

  @@index([createdById])
  @@index([updatedById])
  @@map("page_templates")
}

model PageTemplateTranslation {
  id         Int    @id @default(autoincrement())
  templateId Int    @map("template_id")
  languageId Int    @map("language_id")
  name       String @db.VarChar(255)

  template PageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  language Language     @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([templateId, languageId])
  @@index([languageId])
  @@map("page_template_translations")
}

// ==========================================
// PAGES
// ==========================================

model Page {
  id             Int       @id @default(autoincrement())
  parentId       Int?      @map("parent_id")
  templateId     Int       @map("template_id")
  sortOrder      Int       @default(0) @map("sort_order")
  published      Boolean   @default(false)
  showInMenu     Boolean   @default(false) @map("show_in_menu")
  isHome         Boolean   @default(false) @map("is_home")
  featureImageId Int?      @map("feature_image_id")
  createdById    Int?      @map("created_by_id")
  updatedById    Int?      @map("updated_by_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt      DateTime? @map("deleted_at")

  featureImage Media?            @relation("PageFeatureImage", fields: [featureImageId], references: [id], onDelete: SetNull)
  parent       Page?             @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  template     PageTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  children     Page[]            @relation("PageHierarchy")
  translations PageTranslation[]
  slugAliases  PageSlugAlias[]
  versions     PageVersion[]
  createdBy    User?             @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?             @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  posts        Post[]            @relation("PostPages")

  @@index([parentId])
  @@index([templateId])
  @@index([published])
  @@index([showInMenu])
  @@index([isHome])
  @@index([featureImageId])
  @@map("pages")
}

model PageTranslation {
  id              Int       @id @default(autoincrement())
  pageId          Int       @map("page_id")
  languageId      Int       @map("language_id")
  title           String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(255)
  subtitle        String?   @db.VarChar(255)
  excerpt         String?   @db.Text
  content         String?   @db.Text
  description     String?   @db.Text
  metaTitle       String?   @map("meta_title") @db.VarChar(255)
  metaDescription String?   @map("meta_description") @db.Text
  keywords        String?   @db.Text
  focusKeyword    String?   @map("focus_keyword") @db.VarChar(255)
  canonicalUrl    String?   @map("canonical_url") @db.VarChar(500)
  publishedAt     DateTime? @map("published_at") @db.Timestamp(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt       DateTime? @map("deleted_at")

  page     Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  language Language           @relation(fields: [languageId], references: [id])
  blocks   PageContentBlock[]

  @@unique([pageId, languageId], name: "pageId_languageId")
  @@index([languageId])
  @@index([slug])
  @@map("page_translations")
}

model PageSlugAlias {
  id         Int      @id @default(autoincrement())
  pageId     Int      @map("page_id")
  languageId Int      @map("language_id")
  slug       String   @unique @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  page     Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id])

  @@index([pageId])
  @@index([languageId])
  @@map("page_slug_aliases")
}

model PageContentBlock {
  id            Int      @id @default(autoincrement())
  translationId Int      @map("translation_id")
  type          String   @db.VarChar(50)
  data          Json
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  translation PageTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@index([translationId])
  @@index([type])
  @@index([sortOrder])
  @@map("page_content_blocks")
}

model PageVersion {
  id         Int      @id @default(autoincrement())
  pageId     Int      @map("page_id")
  languageId Int      @map("language_id")
  snapshot   Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  page     Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id])

  @@index([pageId])
  @@index([languageId])
  @@map("page_versions")
}

// ==========================================
// POSTS
// ==========================================

model Post {
  id           Int       @id @default(autoincrement())
  type         PostType  @default(news)
  authorId     Int?      @map("author_id")
  coverImageId Int?      @map("cover_image_id")
  published    Boolean   @default(false)
  isFeatured   Boolean   @default(false) @map("is_featured")
  viewCount    Int       @default(0) @map("view_count")
  publishedAt  DateTime? @map("published_at") @db.Timestamp(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp(0)

  coverImage   Media?             @relation("PostCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)
  author       User?              @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  translations PostTranslation[]
  slugAliases  PostSlugAlias[]
  pages        Page[]             @relation("PostPages")
  versions     PostVersion[]
  categories   PostCategoryPost[]

  @@index([type])
  @@index([authorId])
  @@index([published])
  @@index([publishedAt])
  @@index([isFeatured])
  @@index([deletedAt])
  @@index([coverImageId])
  @@map("posts")
}

model PostTranslation {
  id              Int      @id @default(autoincrement())
  postId          Int      @map("post_id")
  languageId      Int      @map("language_id")
  title           String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(255)
  excerpt         String?  @db.Text
  content         String?  @db.Text
  metaTitle       String?  @map("meta_title") @db.VarChar(255)
  metaDescription String?  @map("meta_description") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  post     Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  language Language           @relation(fields: [languageId], references: [id])
  blocks   PostContentBlock[]

  @@unique([postId, languageId], name: "postId_languageId")
  @@index([languageId])
  @@index([slug])
  @@map("post_translations")
}

model PostSlugAlias {
  id         Int      @id @default(autoincrement())
  postId     Int      @map("post_id")
  languageId Int      @map("language_id")
  slug       String   @unique @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id])

  @@index([postId])
  @@index([languageId])
  @@map("post_slug_aliases")
}

model PostContentBlock {
  id            Int      @id @default(autoincrement())
  translationId Int      @map("translation_id")
  type          String   @db.VarChar(50)
  data          Json
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  translation PostTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@index([translationId])
  @@index([type])
  @@index([sortOrder])
  @@map("post_content_blocks")
}

model PostVersion {
  id         Int      @id @default(autoincrement())
  postId     Int      @map("post_id")
  languageId Int      @map("language_id")
  snapshot   Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id])

  @@index([postId])
  @@index([languageId])
  @@map("post_versions")
}

// ==========================================
// POST CATEGORIES (NEW)
// ==========================================

model PostCategory {
  id        Int      @id @default(autoincrement())
  parentId  Int?     @map("parent_id")
  slug      String   @unique @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  parent       PostCategory?             @relation("PostCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     PostCategory[]            @relation("PostCategoryHierarchy")
  translations PostCategoryTranslation[]
  posts        PostCategoryPost[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@map("post_categories")
}

model PostCategoryTranslation {
  id          Int      @id @default(autoincrement())
  categoryId  Int      @map("category_id")
  languageId  Int      @map("language_id")
  slug        String   @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  category PostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language Language     @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([categoryId, languageId])
  @@index([languageId])
  @@map("post_category_translations")
}

model PostCategoryPost {
  postId     Int      @map("post_id")
  categoryId Int      @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  post     Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  category PostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
  @@map("post_category_posts")
}

// ==========================================
// MENU
// ==========================================

model Menu {
  id        Int       @id @default(autoincrement())
  title     String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id        Int     @id @default(autoincrement())
  menuId    Int     @map("menu_id")
  parentId  Int?    @map("parent_id")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0)

  type        String  @default("custom") @db.VarChar(50)
  url         String? @db.VarChar(500)
  target      String  @default("_self") @db.VarChar(20)
  referenceId Int?    @map("reference_id")

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemHierarchy")

  translations MenuItemTranslation[]

  @@index([menuId], map: "menu_items_menu_id_index")
  @@index([parentId], map: "menu_items_parent_id_index")
  @@map("menu_items")
}

model MenuItemTranslation {
  id         Int    @id @default(autoincrement())
  menuItemId Int    @map("menu_item_id")
  languageId Int    @map("language_id")
  label      String @db.VarChar(255)
  slug       String @db.VarChar(255)

  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, languageId], map: "menu_item_translations_item_language_unique")
  @@index([languageId], map: "menu_item_translations_language_id_index")
  @@map("menu_item_translations")
}

// ==========================================
// MEDIA
// ==========================================

model MediaFolder {
  id       Int    @id @default(autoincrement())
  name     String
  slug     String
  scope    String @default("site")
  order    Int    @default(0)
  parentId Int?   @map("parent_id")

  parent     MediaFolder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Restrict)
  subFolders MediaFolder[] @relation("SubFolders")
  media      Media[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([slug, parentId])
  @@index([parentId])
  @@index([scope])
  @@map("media_folders")
}

model Media {
  id Int @id @default(autoincrement())

  filename     String
  originalName String
  path         String
  url          String

  mimeType String
  size     Int

  width  Int?
  height Int?

  legacyFolder String       @default("general") @map("legacy_folder")
  folderId     Int?         @map("folder_id")
  folder       MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  scope String   @default("site")
  tags  String[]

  alt     String?
  caption String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Back-relations
  pages Page[] @relation("PageFeatureImage")
  posts Post[] @relation("PostCoverImage")
  users User[] @relation("UserAvatar")

  @@index([legacyFolder])
  @@index([folderId])
  @@index([scope])
  @@index([mimeType])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("media")
}

// ==========================================
// SETTINGS
// ==========================================
model Setting {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  label       String
  description String?

  isPublic Boolean @default(false)
  isActive Boolean @default(true)

  settingGlobalContent    SettingGlobalContent?
  settingLocalizedContent SettingLocalizedContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model SettingGlobalContent {
  id        Int  @id @default(autoincrement())
  settingId Int  @unique
  value     Json

  setting Setting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@map("setting_global_contents")
}

model SettingLocalizedContent {
  id         Int  @id @default(autoincrement())
  settingId  Int
  languageId Int
  value      Json

  setting  Setting  @relation(fields: [settingId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([settingId, languageId])
  @@map("setting_localized_contents")
}

// ==========================================
// BLOCK TYPE DEFINITIONS
// ==========================================

model BlockTypeDefinition {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(50)
  label       String   @db.VarChar(255)
  description String?  @db.Text
  scope       String   @db.VarChar(20)
  icon        String?  @db.VarChar(50)
  schema      Json
  defaultData Json?    @map("default_data")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([scope])
  @@index([isEnabled])
  @@index([key])
  @@map("block_type_definitions")
}

// ==========================================
