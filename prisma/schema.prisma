  @@map("user_notification_states")
}

// ==========================================
// CHAT
// ==========================================

enum ChatSessionStatus {
  open
  closed
}

model ChatSession {
  id                      String            @id @default(cuid())
  visitorName             String?           @map("visitor_name") @db.VarChar(255)
  visitorEmail            String?           @map("visitor_email") @db.VarChar(255)
  visitorPhone            String?           @map("visitor_phone") @db.VarChar(50)
  visitorLanguage         String?           @map("visitor_language") @db.VarChar(10)
  operatorId              Int?              @map("operator_id")
  knownUserId             Int?              @map("known_user_id")
  status                  ChatSessionStatus @default(open)
  startedAt               DateTime          @default(now()) @map("started_at") @db.Timestamp(0)
  closedAt                DateTime?         @map("closed_at") @db.Timestamp(0)
  // Stamped once, the first time operatorId transitions from null to
  // non-null (auto-assign or manual) — see ChatService.assignOperator.
  // Waiting time = assignedAt - startedAt. Not updated on later
  // reassignment, so it stays a "time to first pickup" metric.
  assignedAt              DateTime?         @map("assigned_at") @db.Timestamp(0)
  // visitor context
  visitorBrowser          String?           @map("visitor_browser") @db.VarChar(500)
  visitorIp               String?           @map("visitor_ip") @db.VarChar(100)
  visitorPage             String?           @map("visitor_page") @db.VarChar(1000)
  // closure
  resolutionTag           String?           @map("resolution_tag") @db.VarChar(50)
  closureSummary          String?           @map("closure_summary") @db.Text
  closedByOperatorId      Int?              @map("closed_by_operator_id")
  // reporting taxonomy — settable any time during the session, not just at
  // close; both nullable (existing rows have neither)
  regionId                String?           @map("region_id")
  programId               String?           @map("program_id")
  // post-chat survey
  visitorRating           Int?              @map("visitor_rating")
  visitorRatingComment    String?           @map("visitor_rating_comment") @db.VarChar(1000)
  // contact request — submitted via the queue/close "leave contact info"
  // popup, distinct from the intro-form visitor* fields above (the visitor
  // may correct/override those here). resolutionTag stays one of the 3 real
  // close reasons even for these sessions (see ChatGateway.
  // handleVisitorLeaveContactInfo) — contactInfoLeft is the dedicated flag
  // for "did the visitor submit this form", independent of how the session
  // is classified for close-reason reporting. contactRequestEmailSent is a
  // separate true/false/null: null = never attempted, true/false = the
  // notification email's actual send outcome.
  contactInfoLeft         Boolean           @default(false) @map("contact_info_left")
  contactRequestName      String?           @map("contact_request_name") @db.VarChar(255)
  contactRequestPhone     String?           @map("contact_request_phone") @db.VarChar(50)
  contactRequestEmail     String?           @map("contact_request_email") @db.VarChar(255)
  contactRequestMessage   String?           @map("contact_request_message") @db.Text
  contactRequestAt        DateTime?         @map("contact_request_at") @db.Timestamp(0)
  contactRequestEmailSent Boolean?          @map("contact_request_email_sent")
  deletedAt               DateTime?         @map("deleted_at") @db.Timestamp(0)
  // Last time the visitor's widget had this session's messages in view —
  // lets the operator UI show a "Seen" marker on its own messages. One
  // timestamp per session (not per-message) is enough for a support-chat
  // "seen up to here" indicator; there's no operator-side equivalent, the
  // visitor widget never shows whether the operator has read a reply.
  visitorLastReadAt       DateTime?         @map("visitor_last_read_at") @db.Timestamp(0)

  operator         User?         @relation("ChatOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  knownUser        User?         @relation("ChatKnownUser", fields: [knownUserId], references: [id], onDelete: SetNull)
  closedByOperator User?         @relation("ChatClosedBy", fields: [closedByOperatorId], references: [id], onDelete: SetNull)
  program          Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  region           Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  messages         ChatMessage[]

  @@index([operatorId])
  @@index([knownUserId])
  @@index([status])
  @@index([startedAt])
  @@index([closedByOperatorId])
  @@index([regionId])
  @@index([programId])
  @@index([deletedAt])
  @@index([contactInfoLeft])
  @@map("chat_sessions")
}

model ChatMessage {
  id         String   @id @default(cuid())
  sessionId  String   @map("session_id")
  authorId   Int?     @map("author_id")
  role       String   @db.VarChar(20)
  body       String   @db.Text
  // True only for messages whose body is a small, sanitized HTML fragment
  // (currently just canned responses sent as-is, preserving the formatting
  // they were authored with). Everything an operator or visitor types stays
  // plain text with this false, and renderers must keep escaping those —
  // never infer HTML-ness from the body's content.
  isHtml     Boolean  @default(false) @map("is_html")
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User?       @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

model CannedResponse {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  body        String   @db.Text
  categoryId  String?  @map("category_id")
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Non-null only for the handful of system-triggered rows (greeting,
  // queue_wait, inactivity_warning, inactivity_close) that the gateway sends
  // automatically instead of an operator picking from the composer. NULL for
  // every regular operator-facing template — Postgres allows unlimited NULLs
  // through a unique index, so this still guarantees at most one row per
  // trigger. Gated on chat.manage (supervisor), not chat.close, since editing
  // these changes live system behavior for every visitor.
  trigger        String? @db.VarChar(30)
  // Only meaningful for inactivity_warning/inactivity_close — how long after
  // the relevant activity before this message fires. Null for triggers that
  // fire immediately (greeting, queue_wait).
  delaySeconds   Int?    @map("delay_seconds")
  // Only meaningful when trigger is non-null — lets a supervisor turn an
  // automatic message off (e.g. disable auto-close) without losing its
  // customized text/delay. Ignored for regular (trigger=null) templates.
  isEnabled      Boolean @default(true) @map("is_enabled")
  // Only meaningful for close_confirm/session_ended — a second translatable
  // field the other triggers don't need (they're single-line chat messages;
  // these are a popup/screen with a mandatory header + optional body). Null
  // for every other trigger and for regular templates.
  header         String? @db.VarChar(255)
  // Only meaningful for close_confirm/session_ended — the label of the
  // single action button each renders (Cancel / Start New Chat). Optional;
  // falls back to the widget's static dictionary text when unset.
  buttonText     String? @db.VarChar(100)
  // Only meaningful for intro_form — a free-form {fieldKey: text} map
  // (widgetTitle/nameLabel/phoneLabel/emailLabel/nameRequired/
  // phoneRequired/startButton) since that trigger has more editable strings
  // than the single header+body+buttonText shape fits. Null for every other
  // trigger.
  fields         Json?
  // Only meaningful for intro_form — which of the visitor-facing inputs
  // (subset of "name"/"phone"/"email") are required before submit. Not
  // translatable (requiredness doesn't vary by language), so unlike
  // header/buttonText/fields there's no per-language override in
  // CannedResponseTranslation. Null falls back to the hardcoded default
  // (name + phone required, email optional).
  requiredFields Json?

  deletedAt DateTime? @map("deleted_at")

  createdBy    User                        @relation("CannedResponseAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  translations CannedResponseTranslation[]
  // Cascade: hard-deleting a category permanently deletes every response
  // under it too (see CannedResponseCategory below) — soft delete/restore of
  // a category is handled manually in ChatService, cascading deletedAt onto
  // active responses and unconditionally restoring all of them on restore.
  category     CannedResponseCategory?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([trigger])
  @@index([createdById])
  @@index([categoryId])
  @@map("canned_responses")
}

// Per-language override of an automatic message's body. Only used for the 4
// system-triggered CannedResponse rows (trigger != null) — regular
// operator-facing templates are single-language. CannedResponse.body remains
// the fallback (used when the visitor's language has no row here, e.g. a
// language newly activated before a supervisor has translated it).
model CannedResponseTranslation {
  id               Int      @id @default(autoincrement())
  cannedResponseId String   @map("canned_response_id")
  languageId       Int      @map("language_id")
  body             String   @db.Text
  // Translation of CannedResponse.header — only populated for
  // close_confirm/session_ended.
  header           String?  @db.VarChar(255)
  // Translation of CannedResponse.buttonText — only populated for
  // close_confirm/session_ended.
  buttonText       String?  @db.VarChar(100)
  // Translation of CannedResponse.fields — only populated for intro_form.
  fields           Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  cannedResponse CannedResponse @relation(fields: [cannedResponseId], references: [id], onDelete: Cascade)
  language       Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([cannedResponseId, languageId])
  @@map("canned_response_translations")
}

// Managed category for regular (trigger=null) canned responses — replaces
// the old free-text CannedResponse.category string. Same soft-delete +
// trash/restore/hard-delete shape as Program/Region, but with a manual
// cascade: trashing a category also trashes its currently-active responses,
// restoring it unconditionally restores every response under it (even ones
// that had been trashed individually before), and hard-deleting it cascades
// at the DB level via CannedResponse.category's onDelete: Cascade above.
model CannedResponseCategory {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(100)
  sortOrder Int       @default(0) @map("sort_order")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  responses CannedResponse[]

  @@index([deletedAt])
  @@map("canned_response_categories")
}

// Singleton row (id fixed to 1) holding small global chat-behavior knobs a
// supervisor tunes from the CMS's Automatic Messages panel — currently just
// the per-operator active-chat cap the gateway enforces on auto-assignment
// (pickAvailableOperator/drainQueue). Cached in-memory by ChatGateway and
// reloaded via invalidateChatConfigCache after a save, same pattern as the
// automatic-message cache.
model ChatConfig {
  id                      Int    @id @default(1)
  maxActiveChats          Int    @default(3) @map("max_active_chats")
  // Team-wide notification sound settings — supervisor-set (chat.manage_config),
  // applied for every operator rather than a per-browser preference. soundId is
  // one of "chime" | "bell" | "alert" | "none" (validated in UpdateChatConfigDto,
  // not a DB enum since it's a small closed set owned by the frontend player).
  notificationSound       String @default("chime") @map("notification_sound")
  notificationVolume      Float  @default(0.5) @map("notification_volume")
  // Multiplier applied to each sound's base duration/envelope (0.5x-2x) —
  // lets a supervisor make the alert noticeably longer without adding more
  // sound presets.
  notificationDuration    Float  @default(1) @map("notification_duration")
  // Multiplier applied to every preset's literal frequencies (0.5x-2x).
  notificationPitch       Float  @default(1) @map("notification_pitch")
  // How many times the sound plays back-to-back (1-5) for a single new
  // message — repeats are spaced using each preset's own rough length, see
  // BASE_DURATION_MS in notificationSounds.ts.
  notificationRepeatCount Int    @default(1) @map("notification_repeat_count")

  // Same 5 knobs again, for a second, distinct trigger: a brand-new session
  // arriving (vs. notification* above, which is "a message landed in a chat
  // I'm not currently looking at"). Operator-only — visitors initiate chats
  // themselves, so "a new chat arrived" isn't an event on their side.
  newChatNotificationSound       String @default("chime") @map("new_chat_notification_sound")
  newChatNotificationVolume      Float  @default(0.5) @map("new_chat_notification_volume")
  newChatNotificationDuration    Float  @default(1) @map("new_chat_notification_duration")
  newChatNotificationPitch       Float  @default(1) @map("new_chat_notification_pitch")
  newChatNotificationRepeatCount Int    @default(1) @map("new_chat_notification_repeat_count")

  // Same 5 knobs, mirrored for the visitor-facing widget (public website)
  // instead of the operator CMS — deliberately separate rows since the two
  // audiences shouldn't be forced to share one sound. Read via a @Public()
  // endpoint (no chat.view session) since visitors aren't authenticated.
  visitorNotificationSound       String @default("chime") @map("visitor_notification_sound")
  visitorNotificationVolume      Float  @default(0.5) @map("visitor_notification_volume")
  visitorNotificationDuration    Float  @default(1) @map("visitor_notification_duration")
  visitorNotificationPitch       Float  @default(1) @map("visitor_notification_pitch")
  visitorNotificationRepeatCount Int    @default(1) @map("visitor_notification_repeat_count")

  // Same 5 knobs again, for the visitor's own outgoing message — visitor-only.
  // Defaults to a messenger-style preset rather than "chime" since this is
  // specifically the "message sent" feel real chat apps use.
  visitorSentNotificationSound       String @default("whatsapp") @map("visitor_sent_notification_sound")
  visitorSentNotificationVolume      Float  @default(0.5) @map("visitor_sent_notification_volume")
  visitorSentNotificationDuration    Float  @default(1) @map("visitor_sent_notification_duration")
  visitorSentNotificationPitch       Float  @default(1) @map("visitor_sent_notification_pitch")
  visitorSentNotificationRepeatCount Int    @default(1) @map("visitor_sent_notification_repeat_count")

  // Same 5 knobs, mirrored for the operator's own outgoing message — the
  // counterpart to notification* (operator "receiving" trigger) so operators
  // get the same received/sent split visitors do, on top of the separate
  // newChatNotification* trigger above. Same messenger-style default as the
  // visitor's sent sound.
  operatorSentNotificationSound       String @default("whatsapp") @map("operator_sent_notification_sound")
  operatorSentNotificationVolume      Float  @default(0.5) @map("operator_sent_notification_volume")
  operatorSentNotificationDuration    Float  @default(1) @map("operator_sent_notification_duration")
  operatorSentNotificationPitch       Float  @default(1) @map("operator_sent_notification_pitch")
  operatorSentNotificationRepeatCount Int    @default(1) @map("operator_sent_notification_repeat_count")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chat_config")
}

// Reporting taxonomy for chat sessions — simple, admin-managed, non-translatable.
// Internal categorization picked by the operator, never shown to visitors,
// so (unlike Programs' comment above once implied) there's no per-language
// override — always entered/displayed in whatever language staff use.
model Program {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  sessions ChatSession[]

  @@index([deletedAt])
  @@map("chat_programs")
}

// Chat reporting taxonomy — same shape/CRUD pattern as Program, replacing
// the old free-text ChatSession.region column with a managed pick-list.
// Also internal-only / non-translatable, same reasoning as Program above.
model Region {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  sessions ChatSession[]

  @@index([deletedAt])
  @@map("chat_regions")
}

// Operator-to-operator direct messages
model OperatorThread {
  id             String   @id @default(cuid())
  participant1Id Int      @map("participant1_id")
  participant2Id Int      @map("participant2_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  participant1 User              @relation("DmParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2 User              @relation("DmParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages     OperatorMessage[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
  @@map("operator_threads")
}

model OperatorMessage {
  id        String   @id @default(cuid())
  threadId  String   @map("thread_id")
  authorId  Int      @map("author_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  thread OperatorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User           @relation("DmAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([createdAt])
  @@map("operator_messages")
}
