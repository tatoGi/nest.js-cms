🔍 HOW IT WORKS: Query Flow
When User Visits Tourism Development Page:
sql-- Step 1: Backend receives request
GET /api/v1/programs/tourism-development?locale=ka

-- Step 2: Fetch program
SELECT * FROM programs 
WHERE slug = 'tourism-development' 
AND published = true;
-- Result: program_id = 12

-- Step 3: Fetch translation
SELECT * FROM program_translations 
WHERE program_id = 12 
AND locale = 'ka';
-- Result: translation_id = 201

-- Step 4: Fetch content blocks
SELECT * FROM program_content_blocks 
WHERE translation_id = 201 
ORDER BY sort_order;

-- Result:
-- Block 1: type='text', data={...}
-- Block 2: type='programs_listing', data={...} ← This one!
-- Block 3: type='accordion', data={...}

-- Step 5: Process 'programs_listing' block
-- Backend sees type='programs_listing'
-- Reads data.displayMode = 'auto'
-- Automatically fetches children!

SELECT p.*, pt.title, pt.description, pt.slug
FROM programs p
JOIN program_translations pt ON p.id = pt.program_id
WHERE p.parent_id = 12  -- Children of Tourism Development
  AND p.published = true
  AND p.is_active = true
  AND pt.locale = 'ka'
ORDER BY p.sort_order;

-- Result: 4 children programs (121, 122, 123, 124)

-- Step 6: Return complete response
