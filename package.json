{
  "name": "cms-backend",
  "version": "1.0.0",
  "description": "CMS Backend with NestJS and Prisma",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run format:check && npm run typecheck",
    "prepare": "husky || true",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "chat-redis:up": "docker compose -f docker-compose.redis.yml up -d",
    "chat-redis:down": "docker compose -f docker-compose.redis.yml stop",
    "chat-redis:status": "docker compose -f docker-compose.redis.yml ps",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node -P prisma/seeds/tsconfig.json prisma/seeds/seed.ts",
    "prisma:seed:chat": "ts-node -P prisma/seeds/tsconfig.json prisma/seeds/seed-chat.ts",
    "prisma:seed:chat:permissions": "ts-node -P prisma/seeds/tsconfig.json prisma/seeds/seed-chat.ts",
    "prisma:seed:chat:data": "ts-node -P prisma/seeds/tsconfig.json prisma/seeds/seed-chat-data.ts",
    "prisma:seed:chat:dev": "ts-node -P prisma/seeds/tsconfig.json prisma/seeds/seed-chat-data.ts && ts-node -P prisma/seeds/tsconfig.json prisma/seeds/seed-chat-dev-users.ts && ts-node -P prisma/seeds/tsconfig.json prisma/seeds/seed-chat-dev-data.ts && ts-node -P prisma/seeds/tsconfig.json prisma/seeds/seed-chat-demo.ts",
    "prisma:export": "ts-node -P prisma/seeds/tsconfig.json prisma/seeds/export-to-json.ts",
    "prisma:media:import": "ts-node -P prisma/seeds/tsconfig.json prisma/seeds/seed-media-import.ts",
    "prisma:media:cleanup": "ts-node -P prisma/seeds/tsconfig.json prisma/seeds/media-cleanup.ts",
    "prisma:media:cleanup:execute": "ts-node -P prisma/seeds/tsconfig.json prisma/seeds/media-cleanup.ts --execute",
    "prisma:db:clean": "ts-node -P prisma/seeds/tsconfig.json prisma/seeds/db-truncate.ts --execute",
    "prisma:db:clean:seed": "npm run prisma:db:clean && ts-node -P prisma/seeds/tsconfig.json prisma/seeds/seed-json-data.ts",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:db:push": "prisma db push",
    "prisma:db:push:force": "prisma db push --accept-data-loss",
    "prisma:db:pull": "prisma db pull",
    "prisma:reset:dev": "npm run prisma:format && npm run prisma:validate && npm run prisma:export && prisma migrate reset --force --skip-seed && npm run prisma:migrate && npm run prisma:generate && npm run prisma:seed && npx tsc --noEmit",
    "prisma:db:push-seed": "npm run prisma:db:push:force && npm run prisma:generate && npm run prisma:seed && npm run prisma:format && npm run prisma:validate",
    "ci": "npm ci && npx prisma generate && npm run typecheck && npm run lint:check && npm run test:cov && npm run build"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^5.1.1",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "file-type": "^21.3.0",
    "ioredis": "^5.11.1",
    "ms": "^2.1.3",
    "nest-winston": "^1.10.2",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.15.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.21.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.1.1",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{ts,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
