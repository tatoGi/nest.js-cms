# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cms_db?schema=public"

# Application
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-this-to-a-different-secret
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECURE=false

# CORS
CORS_ORIGIN=http://localhost:3000

# API
API_PREFIX=api
API_VERSION=v1

# Chat business hours — Georgia has had no DST since 2004, so this is a
# fixed offset. Optional; defaults to Asia/Tbilisi if unset.
BUSINESS_HOURS_TIMEZONE=Asia/Tbilisi

# Redis — backs the chat round-robin operator-assignment queue.
REDIS_URL=redis://localhost:6379
